<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ビルド時に Secrets.xcconfig（base configuration）から注入される。
	     ソースには $(...) のみ残り、実値はコミットされない。 -->
	<key>APIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>APIKey</key>
	<string>$(API_KEY)</string>
	<!-- バックグラウンド・ロック画面での音声再生継続のために必要（issue #79）。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 開発用バックエンドが http://localhost のため、ローカル平文通信を許可する。
	     localhost / *.local / 直リンク IP に限定（任意 http の全許可はしない）。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 標準TLS以外の独自暗号を実装していないため、輸出コンプライアンス回答を固定する
	     （App Store Connect アップロード時の対話プロンプトを回避）。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
